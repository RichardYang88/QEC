# Python
*.pyc
__pycache__/
venv/
qenv/
env/
.venv/
*.egg-info/
dist/
build/

# IDE / OS
.DS_Store
.idea/
.vscode/

# logs & secrets
# NOTE: 43 .log files were committed before this rule existed and are still
# TRACKED; gitignore does not untrack them.  `git rm --cached *.log` happens in
# the pre-archive repository cleanup, not here.
*.log
# ... EXCEPT the hardware run logs.  They are the only record of what a paid
# submission actually did: the wall time, the shots returned per chunk, the
# dashboard readings that bracket it and the verdict printed at the time.  The
# manuscript's hardware section quotes them, so they are evidence and are tracked.
!hw_evidence/
!hw_evidence/*.log
!hw_evidence/*.txt
.env
.originq_token
# never let a credentials file be committed under any name
*token*
*secret*
*credential*

# generated reports (kept locally, not committed)
report/
supplement.md

# downloaded TeX distribution used to compile the manuscript locally: a vendor
# tarball from CTAN, not source (8.4 MB, regenerable)
paper/revtex-tds/
